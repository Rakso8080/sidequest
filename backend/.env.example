# SideQuest backend configuration.
# Copy this file to backend/.env and fill in real values.

# REQUIRED in production — a long random string used to sign JWT tokens.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional — defaults to the local SQLite file (backend/app.db).
# Swap to Postgres for a real deployment, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/sidequest

# Optional — comma-separated list of allowed browser origins.
# In dev the frontend proxies /api so "*" is fine. In production set it to
# your actual origin(s), e.g. https://sidequest.example.com
CORS_ORIGINS=

# Optional — directory for photo/video proof uploads.
# UPLOAD_DIR=/app/uploads

# Optional — directory containing the built SPA (frontend/dist).
# Defaults to ../frontend/dist relative to the backend package.
# STATIC_DIR=/app/frontend/dist
